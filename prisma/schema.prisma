generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  fullName     String
  email        String?   @unique
  role         String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ordersClosed Order[]   @relation("orders_closed_by")
  ordersOpened Order[]   @relation("orders_opened_by")
  payments     Payment[] @relation("payments_created_by")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  items       Item[]
}

model Item {
  id         Int         @id @default(autoincrement())
  name       String
  sku        String?     @unique
  price      Decimal
  taxRate    Decimal
  isActive   Boolean     @default(true)
  stockQty      Int      @default(0)
  reorderLevel  Int      @default(10)
  categoryId Int
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model RestaurantTable {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  capacity Int
  status   String
  isActive Boolean @default(true)
  orders   Order[]
}

model Room {
  id               Int     @id @default(autoincrement())
  roomNumber       String  @unique
  floor            String?
  status           String
  currentGuestName String?
  orders           Order[]
}

model Order {
  id            Int              @id @default(autoincrement())
  orderNumber   String           @unique
  type          String
  status String // open | closed | cancelled | refunded
  tableId       Int?
  roomId        Int?
  openedById    Int
  closedById    Int?
  subtotal      Decimal
  taxTotal      Decimal
  discountTotal Decimal
  serviceCharge Decimal
  grandTotal    Decimal
  openedAt      DateTime         @default(now())
  closedAt      DateTime?
  closedBy      User?            @relation("orders_closed_by", fields: [closedById], references: [id])
  openedBy      User             @relation("orders_opened_by", fields: [openedById], references: [id])
  room          Room?            @relation(fields: [roomId], references: [id])
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  items         OrderItem[]
  payments      Payment[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  itemId    Int
  itemName  String
  qty       Int
  unitPrice Decimal
  taxRate   Decimal
  discount  Decimal
  lineTotal Decimal
  item      Item    @relation(fields: [itemId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id])
}

model Payment {
  id          Int      @id @default(autoincrement())
  orderId     Int
  method      String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("LKR")
  tipAmount   Decimal? @db.Decimal(12, 2)
  paidAt      DateTime @default(now())
  createdById Int
  change      Decimal? @db.Decimal(12, 2)
  tendered    Decimal? @db.Decimal(12, 2)
  createdBy   User     @relation("payments_created_by", fields: [createdById], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])
}
